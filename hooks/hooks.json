{
  "description": "Load Dogfood at session start and after compaction. No transcript collection.",
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{
        "type": "command",
        "command": "python3 \"${PLUGIN_ROOT}/hooks/session_start.py\"",
        "timeout": 5,
        "statusMessage": "Loading Dogfood",
        "additionalContextLimit": 1000
      }]
    }]
  }
}
